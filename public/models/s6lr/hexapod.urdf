<?xml version="1.0"?>
<robot name="s6lr_hexapod">
  <!-- 
    S6LR Hexapod Robot URDF with ACTUAL STL Meshes
    
    This URDF uses the real mesh files from xml_Files folder.
    The meshes are scaled from mm to meters (0.001 scale factor).
    
    Robot Structure:
    - 6 legs, each with 3 DOF (hip, femur, tibia)
    - Total: 18 actuated joints
  -->

  <!-- ==================== MATERIALS ==================== -->
  <material name="body_white">
    <color rgba="0.95 0.9 0.98 1"/>
  </material>
  <material name="servo_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="hip_blue">
    <color rgba="0 0 0.98 1"/>
  </material>

  <!-- ==================== TORSO (BASE LINK) ==================== -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.02"/>
    </inertial>
    
    <!-- Main body visual meshes -->
    <visual name="vim_top_cover">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/vim_top_cover.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="vim_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/vim base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="main_body_mid">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/main body mid.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="main_body_lower">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/main body lower.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="lower_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/lower base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="camera_holder_A">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/camera holder A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="camera_holder_B">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/camera holder B.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="motor_pitch_roll_holder">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/motor pitch roll holder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="base_roll">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/base roll.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <visual name="hip_motor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/hip motor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    
    <!-- Collision: simplified box for performance -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.08 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEG 1 (FRONT-RIGHT) ==================== -->
  <joint name="hip_joint_1" type="revolute">
    <parent link="torso"/>
    <child link="hip_1"/>
    <origin xyz="-0.050 -0.0035 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="hip_1">
    <inertial>
      <origin xyz="0 0.028 -0.0415" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual name="hip_frame_right_1">
      <origin xyz="0.050 0.0035 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/hip frame right mid.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="hip_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.028 -0.0415" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="femur_joint_1" type="revolute">
    <parent link="hip_1"/>
    <child link="femur_1"/>
    <origin xyz="0 0.028 -0.0415" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="femur_1">
    <inertial>
      <origin xyz="0.04 0.024 0.0115" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual name="servo_femur_1">
      <origin xyz="0.050 -0.0245 0.0415" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/Servo femur.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual name="servo_tibia_1">
      <origin xyz="0.050 -0.0245 0.0415" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/Servo tibia.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual name="femur_frame_1">
      <origin xyz="0.050 -0.0245 0.0415" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/femur frame maini right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0.04 0.024 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="tibia_joint_1" type="revolute">
    <parent link="femur_1"/>
    <child link="tibia_1"/>
    <origin xyz="0.0175 0.0405 0.024" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="tibia_1">
    <inertial>
      <origin xyz="0 0.04 -0.08" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual name="tibia_frame_A_1">
      <origin xyz="0.0325 -0.068 0.0175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/tibia frame A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual name="tibia_link_A_1">
      <origin xyz="0.0325 -0.068 0.0175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/tibia link A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual name="tibia_base_1">
      <origin xyz="0.0325 -0.068 0.0175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/tibia base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <visual name="tibia_link_B_1">
      <origin xyz="0.0325 -0.068 0.0175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/tibia link B.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0 0.04 -0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEG 2 (FRONT-LEFT) ==================== -->
  <joint name="hip_joint_2" type="revolute">
    <parent link="torso"/>
    <child link="hip_2"/>
    <origin xyz="-0.050 0.0035 0" rpy="0 0 0"/>
