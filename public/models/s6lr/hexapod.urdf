<?xml version="1.0"?>
<!--
  Browser URDF generated from Tracking_controller/xml/S6LR_v1.xml.
  MJCF meshes are authored in parent CAD frames. Each visual offset below is
  the negative of its true hinge pivot so the mesh rotates about the same axis
  as the controller model without the previous double translation.
-->
<robot name="s6lr_tracking_controller">
  <material name="robot_black">
    <color rgba="0.025 0.03 0.03 1"/>
  </material>
  <link name="torso">

    <visual name="torso_1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/vim_top_cover.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_2">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/vim base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_3">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/main body mid.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_4">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/main body lower.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_5">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/lower base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_6">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/camera holder A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_7">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/camera holder B.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_8">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/motor pitch roll holder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_9">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/base roll.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>

    <visual name="torso_10">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="xml_Files/hip motor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_black"/>
    </visual>
  </link>

  <!-- Leg 1: right front -->
  <joint name="hip_joint_1" type="revolute">
    <parent link="torso"/>
    <child link="hip_1"/>
    <origin xyz="-0.05 0.0245 -0.0415" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="5" velocity="3"/>
  </joint>
  <link name="hip_1">

    <visual name="hip_frame_1">
      <origin xyz="0 -0.028 0.0415" rpy="0 0 0"/>
